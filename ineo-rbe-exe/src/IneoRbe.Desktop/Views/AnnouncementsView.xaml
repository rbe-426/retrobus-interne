<UserControl x:Class="IneoRbe.Desktop.Views.AnnouncementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Margin="0,0,8,0">
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
        <Button x:Name="NewButton" Content="Nouvelle" Width="80" Height="24" Margin="0,0,6,0" Click="NewButton_Click" />
        <Button x:Name="DeleteButton" Content="Supprimer" Width="80" Height="24" Click="DeleteButton_Click" />
      </StackPanel>
      <ListBox x:Name="AnnouncementList" DisplayMemberPath="DisplayText" SelectionChanged="AnnouncementList_SelectionChanged" />
    </DockPanel>

    <GroupBox Grid.Column="1" Header="Annonce sonore" Padding="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="170" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Nom :" VerticalAlignment="Center" Margin="0,0,0,8" />
        <TextBox x:Name="NameBox" Grid.Column="1" MaxLength="120" Margin="0,0,0,8" />

        <TextBlock Grid.Row="1" Text="Variable de déclenchement :" VerticalAlignment="Center" Margin="0,0,0,8" />
        <ComboBox x:Name="TriggerCombo" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" SelectionChanged="TriggerCombo_SelectionChanged">
          <ComboBoxItem Tag="GPS" Content="Position GPS (arrivée au point)" />
          <ComboBoxItem Tag="PRE" Content="Pré-annonce (X mètres avant le point)" />
        </ComboBox>

        <TextBlock Grid.Row="2" Text="Latitude du point :" VerticalAlignment="Center" Margin="0,0,0,8" />
        <TextBox x:Name="LatitudeBox" Grid.Row="2" Grid.Column="1" Width="160" HorizontalAlignment="Left" Margin="0,0,0,8" />

        <TextBlock Grid.Row="3" Text="Longitude du point :" VerticalAlignment="Center" Margin="0,0,0,8" />
        <TextBox x:Name="LongitudeBox" Grid.Row="3" Grid.Column="1" Width="160" HorizontalAlignment="Left" Margin="0,0,0,8" />

        <TextBlock x:Name="DistanceLabel" Grid.Row="4" Text="Distance (mètres) :" VerticalAlignment="Center" Margin="0,0,0,8" />
        <TextBox x:Name="DistanceBox" Grid.Row="4" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,0,0,8" />

        <TextBlock Grid.Row="5" Text="Fichier son (wav, mp3, wma) :" VerticalAlignment="Center" Margin="0,0,0,8" />
        <DockPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,8">
          <Button x:Name="ListenButton" DockPanel.Dock="Right" Content="Écouter" Width="70" Margin="6,0,0,0" Click="ListenButton_Click" />
          <Button x:Name="ImportButton" DockPanel.Dock="Right" Content="Importer..." Width="80" Margin="6,0,0,0" Click="ImportButton_Click" />
          <TextBox x:Name="SoundBox" IsReadOnly="True" />
        </DockPanel>

        <CheckBox x:Name="EnabledCheck" Grid.Row="6" Grid.Column="1" Content="Annonce activée" IsChecked="True" Margin="0,0,0,8" />

        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button x:Name="SaveButton" Content="Enregistrer" Width="100" Height="26" Click="SaveButton_Click" />
        </StackPanel>
      </Grid>
    </GroupBox>

    <GroupBox Grid.Row="1" Grid.ColumnSpan="2" Header="Diffusion automatique" Margin="0,8,0,0" Padding="8">
      <StackPanel>
        <CheckBox x:Name="EngineCheck" Content="Diffuser les annonces automatiquement selon la position GPS" Checked="EngineCheck_Changed" Unchecked="EngineCheck_Changed" />
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Source GPS :" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ComboBox x:Name="GpsSourceCombo" Grid.Column="1" SelectionChanged="GpsSettings_Changed">
            <ComboBoxItem Tag="AUTO" Content="Automatique (selon Windows)" />
            <ComboBoxItem Tag="WINDOWS" Content="Localisation Windows (7 et +)" />
            <ComboBoxItem Tag="SERIAL" Content="Port série (GPS USB / COM)" />
          </ComboBox>
          <TextBlock Grid.Column="2" Text="Port :" VerticalAlignment="Center" Margin="12,0,6,0" />
          <ComboBox x:Name="GpsPortCombo" Grid.Column="3" IsEditable="True" SelectionChanged="GpsSettings_Changed" LostFocus="GpsSettings_Changed" />
          <TextBlock Grid.Column="4" Text="Bauds :" VerticalAlignment="Center" Margin="12,0,6,0" />
          <ComboBox x:Name="GpsBaudCombo" Grid.Column="5" SelectionChanged="GpsSettings_Changed" />
        </Grid>
        <TextBlock x:Name="EngineStatusText" Margin="0,6,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </GroupBox>
  </Grid>
</UserControl>
