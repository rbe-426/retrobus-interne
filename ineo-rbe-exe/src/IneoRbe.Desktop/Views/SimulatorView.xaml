<UserControl x:Class="IneoRbe.Desktop.Views.SimulatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Margin="0,0,0,6">
      <Button x:Name="SyncButton" DockPanel.Dock="Right" Content="Synchroniser maintenant" Width="170" Height="24" Click="SyncButton_Click" />
      <Button x:Name="TestButton" DockPanel.Dock="Right" Content="Mire de test (60 s)" Width="140" Height="24" Margin="0,0,6,0" Click="TestButton_Click" />
      <TextBlock x:Name="ProfileText" VerticalAlignment="Center" TextWrapping="Wrap" />
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <DockPanel Margin="0,0,8,0">
        <Button x:Name="OpenButton" DockPanel.Dock="Bottom" Content="Ouvrir l'écran simulé" Height="24" Margin="0,6,0,0" IsEnabled="False" Click="OpenButton_Click" />
        <ListBox x:Name="ScreenList" SelectionChanged="ScreenList_SelectionChanged" MouseDoubleClick="ScreenList_MouseDoubleClick" />
      </DockPanel>
      <Border Grid.Column="1" BorderBrush="{x:Static SystemColors.ControlDarkBrush}" BorderThickness="2" Background="White">
        <Viewbox Stretch="Uniform">
          <Canvas x:Name="PlanCanvas" Width="1000" Height="400" />
        </Viewbox>
      </Border>
    </Grid>

    <TextBlock x:Name="HintText" Grid.Row="2" Margin="0,6,0,0" TextWrapping="Wrap" />
  </Grid>
</UserControl>
