<Window x:Class="IneoRbe.Maintenance.MirrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Miroir de l'UC" Width="840" Height="460" MinWidth="500" MinHeight="300"
        Background="#10161B" FontFamily="Tahoma" FontSize="12">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Image x:Name="MirrorImage" Stretch="Uniform" Margin="8" />
    <Border Grid.Row="1" Background="#1F2A33" Padding="10,6">
      <DockPanel>
        <!-- Emplacement réservé aux futurs forçages manuels depuis le miroir. -->
        <TextBlock DockPanel.Dock="Right" Text="Lecture seule" Foreground="#8EA0AF" />
        <TextBlock x:Name="MirrorStatus" Foreground="#C5CED6" Text="Connexion au miroir…" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
