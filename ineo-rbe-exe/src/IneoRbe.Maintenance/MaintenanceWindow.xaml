<Window x:Class="IneoRbe.Maintenance.MaintenanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inéo RétroBus Maintenance" Width="900" Height="640" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#EEF1F4" FontFamily="Tahoma" FontSize="12">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#0F172A" Padding="14,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- Logos de l'en-tête : remplacer Assets\logo.png (gauche) et Assets\header-logo-right.png (droite). -->
        <Image Grid.Column="0" Source="Assets/logo.png" Height="40" Stretch="Uniform" HorizontalAlignment="Left" />
        <TextBlock Grid.Column="1" x:Name="HeaderAuthText" Foreground="#C5CED6" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <Image Grid.Column="2" Source="Assets/header-logo-right.png" Height="40" Stretch="Uniform" HorizontalAlignment="Right" />
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Margin="10" x:Name="Tabs">
      <TabItem Header="Ce PC">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">
            <TextBlock Text="Logiciel et poste" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" />
            <Grid x:Name="InfoGrid">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <Button x:Name="CheckUpdateButton" Content="Rechercher une mise à jour" Padding="12,4" Margin="0,0,8,0" Click="CheckUpdateButton_Click" />
              <Button x:Name="InstallUpdateButton" Content="Installer la mise à jour" Padding="12,4" Visibility="Collapsed" Click="InstallUpdateButton_Click" />
            </StackPanel>
            <TextBlock x:Name="UpdateText" Margin="0,8,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Wi-Fi">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock TextWrapping="Wrap" Text="Recherche les UC sur les réseaux locaux de ce PC (réseau Wi-Fi du dépôt ou point d'accès du véhicule). L'UC doit être allumé, son logiciel ouvert, et le port 47800 autorisé." />
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10">
            <Button x:Name="ScanButton" Content="Détecter les UC" Padding="12,4" Click="ScanButton_Click" />
            <ProgressBar x:Name="ScanBar" Width="200" Height="14" Margin="10,0" Maximum="100" Visibility="Collapsed" />
            <TextBlock x:Name="ScanText" VerticalAlignment="Center" />
          </StackPanel>
          <ListBox x:Name="UcList" Grid.Row="2" />
          <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="ConnectListButton" Content="Se connecter à l'UC sélectionné" Padding="12,4" Click="ConnectListButton_Click" />
            <TextBlock Text="  ou adresse :" VerticalAlignment="Center" />
            <TextBox x:Name="ManualHostBox" Width="150" Margin="6,0" VerticalContentAlignment="Center" />
            <Button Content="Connecter" Padding="12,4" Click="ConnectManualButton_Click" />
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="USB-USB">
        <StackPanel Margin="16">
          <TextBlock TextWrapping="Wrap" Text="Reliez ce PC à l'UC avec un câble USB-USB (câble à pont, qui apparaît comme un port COM), puis choisissez le port. Sur l'UC, le même port doit être choisi dans Paramètres, onglet GPS (Liaison USB-USB de maintenance)." />
          <StackPanel Orientation="Horizontal" Margin="0,12">
            <ComboBox x:Name="PortCombo" Width="200" />
            <Button Content="Actualiser" Padding="12,4" Margin="8,0" Click="RefreshPortsButton_Click" />
            <Button Content="Connecter" Padding="12,4" Click="ConnectSerialButton_Click" />
          </StackPanel>
          <TextBlock x:Name="SerialText" />
        </StackPanel>
      </TabItem>

      <TabItem Header="UC connecté" x:Name="UcTab">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock x:Name="LinkText" FontWeight="Bold" />
          <WrapPanel Grid.Row="1" Margin="0,10">
            <Button Content="Infos générales" Padding="10,4" Margin="0,0,6,6" Click="InfoButton_Click" />
            <Button Content="Date et heure" Padding="10,4" Margin="0,0,6,6" Click="TimeButton_Click" />
            <Button Content="Position" Padding="10,4" Margin="0,0,6,6" Click="PositionButton_Click" />
            <Button Content="Révision de contenu" Padding="10,4" Margin="0,0,6,6" Click="ContentButton_Click" />
            <Button Content="Tout actualiser" Padding="10,4" Margin="0,0,6,6" Click="RefreshAllButton_Click" />
            <Button Content="Ouvrir le miroir" Padding="10,4" Margin="0,0,6,6" Click="MirrorButton_Click" />
            <Button Content="Mettre à jour l'UC" Padding="10,4" Margin="0,0,6,6" Click="RemoteUpdateButton_Click" />
            <Button Content="Déconnecter" Padding="10,4" Margin="0,0,6,6" Click="DisconnectButton_Click" />
          </WrapPanel>
          <TextBox x:Name="ResultBox" Grid.Row="2" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
        </Grid>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="#0F172A" Padding="14,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
          <TextBlock Text="UC connecté" Foreground="#8EA0AF" FontSize="10" />
          <TextBlock x:Name="UcSerialText" Foreground="White" FontSize="15" FontWeight="Bold" Text="Aucun" />
        </StackPanel>
        <UniformGrid x:Name="StatusGrid" Grid.Column="1" Columns="2" />
      </Grid>
    </Border>
  </Grid>
</Window>
