# Discord: ne jamais commiter le fichier .env réel.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Clé publique Discord, utile uniquement pour une future réception d'interactions HTTP.
DISCORD_PUBLIC_KEY=
# Optionnel : synchronise les commandes immédiatement sur le serveur de développement.
DISCORD_GUILD_ID=

# API locale du bot. Elle ne sert qu'au health check à ce stade.
BOT_PORT=4300

# API RBE centrale : requise pour les anniversaires et les futures données communautaires.
RBE_API_URL=
# Secret partagé avec BOT920_SERVICE_TOKEN dans l'environnement de l'API RBE.
BOT920_SERVICE_TOKEN=